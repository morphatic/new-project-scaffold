{
  "$comment": "Config for compound-approver.py. Edit to extend coverage. Commands in safe_commands are approved as first-token of any compound component. Commands in dangerous_first_tokens are never approved. bail_substrings cause the hook to defer to the normal permission flow if any of them appear in the command.",
  "safe_commands": [
    "cd",
    "ls",
    "pwd",
    "cat",
    "head",
    "tail",
    "wc",
    "grep",
    "rg",
    "echo",
    "which",
    "whoami",
    "true",
    "false",
    "git",
    "cargo",
    "npx",
    "npm",
    "pnpm",
    "node",
    "python",
    "python3",
    "gh",
    "markdownlint",
    "cspell",
    "basename",
    "dirname",
    "realpath",
    "readlink",
    "stat",
    "file",
    "date",
    "printenv",
    "env"
  ],
  "safe_with_arg_check": {
    "$comment": "Commands approved only when no deny_flags / deny_subcommands appear in their args. Use for tools that are read-only by default but have flags that make them write or upload.",
    "curl": {
      "deny_flags": [
        "-o", "-O", "--output", "--remote-name", "--remote-header-name",
        "-T", "--upload-file", "-F", "--form",
        "-d", "--data", "--data-binary", "--data-raw", "--data-urlencode",
        "-X", "--request"
      ]
    },
    "sed":   { "deny_flags": ["-i", "--in-place"] },
    "find":  { "deny_flags": ["-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprintf", "-fls"] },
    "sort":  { "deny_flags": ["-o", "--output"] },
    "tree":  { "deny_flags": ["-o"] },
    "sleep": {},
    "du":    {},
    "base64":{},
    "strings":{},
    "nslookup":{},
    "awk":   {},
    "jq":    {},
    "diff":  {},
    "uniq":  {},
    "tr":    {}
  },
  "dangerous_first_tokens": [
    "sudo",
    "su",
    "rm",
    "mv",
    "cp",
    "chmod",
    "chown",
    "mkdir",
    "rmdir",
    "dd",
    "kill",
    "killall",
    "pkill",
    "mkfs",
    "mount",
    "umount",
    "shutdown",
    "reboot"
  ]
}
